MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1541013436852820219}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.85300004, g: 0.85300004, b: 0.85300004, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 2a543b2a68024224ea93bcb7e2be2a9e, type: 3}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<b>Welcome to Vehicle Physics Pro!</b>\r\nThe most realistic and advanced
    vehicle simulation kit for Unity 3D.\r\n\r\nThis demo showcases the typical features
    in a standard car:\r\n\r\n\u2022\tAll-Wheel-Drive (AWD) vs. Two-Wheel-Drive (2WD)\n\u2022\tManual
    vs. Automatic transmission\r\n\u2022\tClutch vs. Torque Converter\r\n\u2022\tAuto-Shift
    in manual transmission\r\n\u2022\tDifferential Lock\r, three levels: axles, center,
    full\n\u2022\tEngine Stall\r\n\u2022\tDriver Assists: ABS, ESC, TCS, ASR\r\n\u2022\tSteering
    Assist\r\n\r\nMore info on Vehicle Physics Pro:\r\n\r\n    vehiclephysics.com\r\n  
    @vehiclephysics\r\n"
