      objectReference: {fileID: 0}
    - target: {fileID: 6722188745014530887, guid: e5682ca1fe94a03449dc3d9ac69945f7,
        type: 3}
      propertyPath: m_Text
      value: '<b>ASR - Anti-Spin Regulation</b>

        Prevents a drive wheel at
        one side of the differential to spin faster than the other wheel by engaging
        the brake in the first one.'
      objectReference: {fileID: 0}
